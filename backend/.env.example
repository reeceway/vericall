# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vericall

# Optional Redis (required for multi-machine websocket routing)
REDIS_URL=redis://localhost:6379/0
# If you're using Upstash REST secrets, set both and backend will auto-convert:
# UPSTASH_REDIS_URL=https://<host>
# UPSTASH_REDIS_TOKEN=<token>
WS_RELAY_CHANNEL=vericall:ws:relay
WS_PRESENCE_TTL_SECONDS=120
WS_PRESENCE_REFRESH_SECONDS=25

# ICE/TURN config for future WebRTC data-channel transport
# ICE provider:
# - auto   : use Twilio NTS when TWILIO_ACCOUNT_SID/TWILIO_AUTH_TOKEN exist, else static STUN/TURN vars
# - twilio : force Twilio NTS token generation
# - static : force static STUN/TURN vars below
VOIP_ICE_PROVIDER=auto

# Option 1: provide explicit JSON (highest priority)
# ICE_SERVERS_JSON=[{"urls":["stun:stun.l.google.com:19302"]},{"urls":["turn:turn.example.com:3478?transport=udp"],"username":"user","credential":"pass"}]
# Option 2: provide STUN/TURN fields directly
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
ICE_TRANSPORT_POLICY=all
ICE_CONFIG_TTL_SECONDS=600

# Runtime verification tuning delivered to iOS at /ml/verification-config
# Optional JSON override. Example:
# VOICE_VERIFICATION_TUNING_JSON={"l2_human_primary_threshold":0.34,"l2_human_secondary_threshold":0.46,"l3_similarity_threshold":0.88}
VOICE_VERIFICATION_TUNING_JSON=
VOICE_VERIFICATION_CONFIG_VERSION=1
VOICE_VERIFICATION_CONFIG_TTL_SECONDS=300

# Twilio (used for OTP + optional Network Traversal Service TURN credentials)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# Security (change in production!)
SECRET_KEY=your-super-secret-key-change-in-production

# Environment
ENVIRONMENT=development
